# Required
API_TOKEN=change-this-token
SMTP_HOST=mail.example.com

# Optional — omit for open-relay (auto-probed on first start)
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_DEFAULT=

# HTTP (defaults shown)
# LISTEN_HOST=0.0.0.0
# LISTEN_PORT=8080

# Limits (defaults shown)
# MAX_RECIPIENTS=20
# MAX_BODY_BYTES=1048576

# Probe config (delete smtp_config.json inside ./config to force re-probe)
# SMTP_CONFIG_PATH=/app/config/smtp_config.json
