services:
  mail-api:
    build: .
    container_name: simple-mail-api
    restart: unless-stopped
    network_mode: host
    environment:
      API_TOKEN: "${API_TOKEN:?set API_TOKEN}"
      LISTEN_HOST: "0.0.0.0"
      LISTEN_PORT: "${LISTEN_PORT:-8080}"
      SMTP_HOST: "${SMTP_HOST:?set SMTP_HOST}"
      SMTP_PORT: "${SMTP_PORT:-587}"
      SMTP_USERNAME: "${SMTP_USERNAME:?set SMTP_USERNAME}"
      SMTP_PASSWORD: "${SMTP_PASSWORD:?set SMTP_PASSWORD}"
      SMTP_TLS: "${SMTP_TLS:-starttls}"
      SMTP_FROM_DEFAULT: "${SMTP_FROM_DEFAULT:?set SMTP_FROM_DEFAULT}"
      SMTP_TIMEOUT_SECONDS: "${SMTP_TIMEOUT_SECONDS:-30}"
      SMTP_SKIP_VERIFY: "${SMTP_SKIP_VERIFY:-false}"
      MAX_RECIPIENTS: "${MAX_RECIPIENTS:-20}"
      MAX_BODY_BYTES: "${MAX_BODY_BYTES:-1048576}"
