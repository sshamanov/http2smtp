services:
  mail-api:
    image: ghcr.io/sshamanov/mail-api:main
    # build: .  # uncomment to build locally instead of pulling
    container_name: simple-mail-api
    restart: unless-stopped
    network_mode: host
    volumes:
      - ./smtp_config.json:/app/smtp_config.json
    environment:
      # Required
      API_TOKEN: "${API_TOKEN:?set API_TOKEN}"
      SMTP_HOST: "${SMTP_HOST:?set SMTP_HOST}"
      # Optional — omit for open-relay (auto-probed)
      SMTP_PORT: "${SMTP_PORT:-}"
      SMTP_USERNAME: "${SMTP_USERNAME:-}"
      SMTP_PASSWORD: "${SMTP_PASSWORD:-}"
      SMTP_FROM_DEFAULT: "${SMTP_FROM_DEFAULT:-}"
      # HTTP
      LISTEN_HOST: "0.0.0.0"
      LISTEN_PORT: "${LISTEN_PORT:-8080}"
      # Limits
      MAX_RECIPIENTS: "${MAX_RECIPIENTS:-20}"
      MAX_BODY_BYTES: "${MAX_BODY_BYTES:-1048576}"
      # Probe config path (delete file to force re-probe)
      SMTP_CONFIG_PATH: "${SMTP_CONFIG_PATH:-/app/smtp_config.json}"
